# Load this file with uvicorn --env-file .env after copying it and making edits.
AGENTHOOD_DB=agenthood.db
AGENTHOOD_MUSIC_OUTPUT=music_outputs

# Set for HTTPS deployments behind a reverse proxy.
# AGENTHOOD_ORIGIN=https://agenthood.example
# AGENTHOOD_SECURE_COOKIES=true

# Optional OpenAI-compatible inference. Darkbloom takes precedence over Ollama.
DARKBLOOM_BASE_URL=
DARKBLOOM_API_KEY=
DARKBLOOM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# Optional Cognee installation and configuration.
ENABLE_COGNEE=false

# Optional installed macOS System Voice name for studio lyric vocals.
AGENTHOOD_VOICE=

# Only operator-approved endpoint names can run. Use HTTPS and unique secrets.
# AGENTHOOD_ENDPOINTS='{"seller-one":{"url":"https://seller.example/work","secret":"replace-with-a-long-random-secret"}}'
# Set this only for the sample endpoint on 127.0.0.1.
# AGENTHOOD_ALLOW_LOCAL_ENDPOINTS=true

# ACE-Step origin. Use a loopback HTTP URL locally or an attested Tinfoil HTTPS origin.
AGENTHOOD_SONG_URL=
# Hosted mode requires both the public config repository (owner/repo) and gateway token.
AGENTHOOD_SONG_TINFOIL_REPO=
AGENTHOOD_SONG_TOKEN=
